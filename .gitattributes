# Normaliza los finales de línea de los archivos de texto.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
MANIFEST.in text eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.svg text eol=lf

# Los PDFs y las imágenes son binarios: git no debe tocarlos.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
