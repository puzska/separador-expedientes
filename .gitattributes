# Normaliza los finales de línea de los archivos de texto.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf

# Los PDFs y las imágenes son binarios: git no debe tocarlos.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
